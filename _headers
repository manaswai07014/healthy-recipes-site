# Static assets (one-year cache)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML (one-hour cache) + P64 security headers (web-pentest skill audit, 2026-09-06)
# - X-Frame-Options DENY prevents clickjacking
# - Strict-Transport-Security 1yr + includeSubDomains (HSTS)
# - X-XSS-Protection 0 (modern browsers honor CSP, legacy disabled)
# - Permissions-Policy denies geolocation/microphone/camera
# - Content-Security-Policy: same-origin + Cloudflare Insights + inline styles
/*
  Cache-Control: public, max-age=3600
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-XSS-Protection: 0
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Service worker (no cache)
/sw.js
  Cache-Control: public, max-age=0, must-revalidate