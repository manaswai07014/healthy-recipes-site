# Static assets (one-year cache)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML (one-hour cache)
/*
  Cache-Control: public, max-age=3600
  # P64: web-pentest skill audit added 3 security headers (2026-09-06).
  # All HTML responses get OWASP-aligned baseline:
  # - X-Frame-Options DENY prevents clickjacking (recipe pages don't need iframes)
  # - Strict-Transport-Security 1yr + includeSubDomains — force HTTPS for all subdomains
  # - X-XSS-Protection 0 — modern browsers honor CSP, legacy XSS auditor disabled per MDN
  # - Permissions-Policy denies geolocation/microphone/camera (recipe site has no need)
  # - Content-Security-Policy allows same-origin only + Cloudflare Insights + Inline styles for Jekyll Liquid
  # Note: CSP does NOT include 'unsafe-inline' for scripts (security tradeoff for Jekyll SEO tag).
  # Referrer-Policy already set by CF Pages default (strict-origin-when-cross-origin).
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-XSS-Protection: 0
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Service worker (no cache)
/sw.js
  Cache-Control: public, max-age=0, must-revalidate